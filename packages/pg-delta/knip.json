{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/extract/extract.ts",
    "src/plan/plan.ts",
    "src/apply/apply.ts",
    "src/proof/prove.ts",
    "src/frontends/index.ts",
    "src/frontends/sql-order.ts",
    "src/frontends/sql-format/index.ts",
    "src/core/index.ts",
    "src/policy/policy.ts",
    "src/integrations/index.ts",
    "src/cli/main.ts",
    "src/**/*.test.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "ignoreBinaries": ["oxfmt", "oxlint"],
  "ignoreDependencies": [
    "@supabase/pg-topo",
    "@supabase/bun-istanbul-coverage"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "enumMembers": "warn",
    "classMembers": "warn",
    "duplicates": "warn"
  }
}
