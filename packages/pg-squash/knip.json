{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/ingest/index.ts",
    "src/classify/index.ts",
    "src/pack/index.ts",
    "src/emit/index.ts",
    "src/**/*.test.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "ignoreBinaries": ["oxfmt", "oxlint"],
  "ignoreDependencies": [
    "@supabase/bun-istanbul-coverage",
    "@supabase/pg-topo"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "enumMembers": "warn",
    "classMembers": "warn",
    "duplicates": "warn"
  }
}
